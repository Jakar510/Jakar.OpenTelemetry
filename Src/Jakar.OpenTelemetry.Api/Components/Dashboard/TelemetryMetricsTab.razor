<div class="panel-head">
    <div>
        <p class="eyebrow">Metrics</p>
        <h3>@TelemetryDashboardFormatter.FormatCount( Records.Count ) points</h3>
    </div>
    <span>Select a point to see buckets, quantiles, exemplars, and metadata.</span>
</div>

@if ( Records.Count == 0 )
{
    <p class="empty-state">No metric points match the current filter set.</p>
}
else
{
    <div class="table-wrap virtual-table">
        <table class="selectable">
            <thead>
            <tr>
                <th>Time</th>
                <th>Service</th>
                <th>Name</th>
                <th>Type</th>
                <th>Value</th>
                <th>Unit</th>
                <th>Temporality</th>
                <th>Attributes</th>
            </tr>
            </thead>
            <tbody>
            @* Only the rows in view (plus a few) exist in the page; the rest are spacers. *@
            <Virtualize Items="Items" Context="metric" ItemSize="46" OverscanCount="15" SpacerElement="tr">
                <tr @key="metric.ID"
                    class="@TelemetryDashboardFormatter.RowClass( metric.ID == SelectedId )"
                    tabindex="0"
                    aria-selected="@( metric.ID == SelectedId ? "true" : "false" )"
                    @onclick="() => SelectedChanged.InvokeAsync( metric.ID )"
                    @onkeydown="args => OnKeyDown( args, metric.ID )">
                    <td>@TelemetryDashboardFormatter.FormatDate( metric.TimestampUtc ?? metric.ReceivedAtUtc )</td>
                    <td>@( metric.ServiceName ?? "unknown" )</td>
                    <td title="@metric.Description">@TelemetryDashboardFormatter.Trim( metric.Name, 48 )</td>
                    <td>@metric.MetricType</td>
                    <td>@TelemetryDashboardFormatter.FormatMetricValue( metric )</td>
                    <td>@metric.Unit</td>
                    <td>@metric.AggregationTemporality</td>
                    <td title="@TelemetryDashboardFormatter.MetricAttributesText( metric )">@TelemetryDashboardFormatter.Trim( TelemetryDashboardFormatter.MetricAttributesText( metric ), 72 )</td>
                </tr>
            </Virtualize>
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary> Virtualize needs a collection with a count; the explorer passes lists. </summary>
    private ICollection<TelemetryMetricRecordDto> Items => Records as ICollection<TelemetryMetricRecordDto> ?? Records.ToList();

    [Parameter] public IReadOnlyList<TelemetryMetricRecordDto> Records         { get; set; } = [ ];
    [Parameter] public Guid?                                   SelectedId      { get; set; }
    [Parameter] public EventCallback<Guid>                     SelectedChanged { get; set; }

    private Task OnKeyDown( KeyboardEventArgs args, Guid id ) => TelemetryDashboardFormatter.IsActivationKey( args )
                                                                    ? SelectedChanged.InvokeAsync( id )
                                                                    : Task.CompletedTask;
}
