<div class="panel-head">
    <div>
        <p class="eyebrow">Traces</p>
        <h3>@TelemetryDashboardFormatter.FormatCount( Records.Count ) spans</h3>
    </div>
    <span>Select a span to see its events, links, flags, and attributes.</span>
</div>

@if ( Records.Count == 0 )
{
    <p class="empty-state">No spans match the current filter set.</p>
}
else
{
    <div class="table-wrap virtual-table">
        <table class="selectable">
            <thead>
            <tr>
                <th>Start</th>
                <th>Service</th>
                <th>Name</th>
                <th>Kind</th>
                <th>Duration</th>
                <th>Status</th>
                <th>Trace</th>
                <th>Attributes</th>
            </tr>
            </thead>
            <tbody>
            @* Only the rows in view (plus a few) exist in the page; the rest are spacers. *@
            <Virtualize Items="Items" Context="span" ItemSize="46" OverscanCount="15" SpacerElement="tr">
                <tr @key="span.ID"
                    class="@TelemetryDashboardFormatter.RowClass( span.ID == SelectedId )"
                    tabindex="0"
                    aria-selected="@( span.ID == SelectedId ? "true" : "false" )"
                    @onclick="() => SelectedChanged.InvokeAsync( span.ID )"
                    @onkeydown="args => OnKeyDown( args, span.ID )">
                    <td>@TelemetryDashboardFormatter.FormatDate( span.StartTimeUtc ?? span.ReceivedAtUtc )</td>
                    <td>@( span.ServiceName ?? "unknown" )</td>
                    <td title="@span.Name">@TelemetryDashboardFormatter.Trim( span.Name, 48 )</td>
                    <td>@span.Kind</td>
                    <td>@TelemetryDashboardFormatter.FormatDuration( span.DurationMilliseconds )</td>
                    <td title="@span.StatusMessage"><span class="badge @TelemetryDashboardFormatter.StatusClass( span.StatusCode )">@( span.StatusCode ?? "Unset" )</span></td>
                    <td title="@( $"{span.TraceId} / {span.SpanId}" )">@TelemetryDashboardFormatter.Trim( span.TraceId, 16 )</td>
                    <td title="@TelemetryDashboardFormatter.AttributesText( span.Attributes )">@TelemetryDashboardFormatter.Trim( TelemetryDashboardFormatter.AttributesText( span.Attributes ), 72 )</td>
                </tr>
            </Virtualize>
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary> Virtualize needs a collection with a count; the explorer passes lists. </summary>
    private ICollection<TelemetrySpanRecordDto> Items => Records as ICollection<TelemetrySpanRecordDto> ?? Records.ToList();

    [Parameter] public IReadOnlyList<TelemetrySpanRecordDto> Records         { get; set; } = [ ];
    [Parameter] public Guid?                                 SelectedId      { get; set; }
    [Parameter] public EventCallback<Guid>                   SelectedChanged { get; set; }

    private Task OnKeyDown( KeyboardEventArgs args, Guid id ) => TelemetryDashboardFormatter.IsActivationKey( args )
                                                                    ? SelectedChanged.InvokeAsync( id )
                                                                    : Task.CompletedTask;
}
