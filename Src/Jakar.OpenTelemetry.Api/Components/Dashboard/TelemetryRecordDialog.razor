@using Jakar.OpenTelemetry.Api.Services
@implements IDisposable

<div class="dialog-backdrop" @onclick="() => Close.InvokeAsync()">
    <div class="dialog @( Trace is null ? string.Empty : "has-trace" )"
         role="dialog"
         aria-modal="true"
         aria-labelledby="record-details-title"
         tabindex="-1"
         @ref="_dialog"
         @onclick:stopPropagation="true"
         @onkeydown="OnKeyDown">
        <div class="dialog-head">
            <p class="eyebrow">Live updates are paused while this is open</p>
            <button type="button" class="action-button" @onclick="() => Close.InvokeAsync()" aria-label="Close details">Close</button>
        </div>

        <div class="dialog-body">
            @if ( Trace is { } trace )
            {
                <section class="trace-view" aria-label="Trace">
                    <div class="panel-head">
                        <div>
                            <p class="eyebrow">Trace</p>
                            <h3 class="wrap">
                                @if ( Tree.Root is { } root )
                                {
                                    <span>@( root.ServiceName ?? "unknown" ): @( root.Name ?? "span" )</span>
                                }
                                <code class="trace-id" title="@trace.TraceId">@ShortId( trace.TraceId )</code>
                            </h3>
                        </div>
                    </div>

                    <dl class="trace-stats">
                        <div><dt>Trace start</dt><dd>@TelemetryDashboardFormatter.FormatDatePrecise( Tree.StartUtc )</dd></div>
                        <div><dt>Duration</dt><dd>@TelemetryDashboardFormatter.FormatDuration( Tree.DurationMilliseconds )</dd></div>
                        <div><dt>Services</dt><dd>@Tree.ServiceCount</dd></div>
                        <div><dt>Depth</dt><dd>@Tree.Depth</dd></div>
                        <div><dt>Total spans</dt><dd>@Tree.Rows.Count</dd></div>
                        @if ( Tree.ErrorCount > 0 )
                        {
                            <div><dt>Errors</dt><dd><span class="badge sev-error">@Tree.ErrorCount</span></dd></div>
                        }
                    </dl>

                    @if ( _loadingTrace )
                    {
                        <p class="muted" role="status">Loading the whole trace...</p>
                    }
                    else if ( _traceError is not null )
                    {
                        <p class="muted" role="status">@_traceError</p>
                    }

                    @if ( Tree.Rows.Count == 0 )
                    {
                        <p class="empty-state">No spans of this trace have been received.</p>
                    }
                    else
                    {
                        <div class="trace-toolbar">
                            <ul class="trace-services" aria-label="Services">
                                @for ( int i = 0; i < Tree.Services.Count; i++ )
                                {
                                    <li><span class="svc-dot svc-@( i % TelemetryTraceTree.SERVICE_COLORS )"></span>@( string.IsNullOrEmpty( Tree.Services[i] ) ? "unknown" : Tree.Services[i] )</li>
                                }
                            </ul>
                            <button type="button" class="action-button small" @onclick="ExpandAll" disabled="@( _collapsed.Count == 0 )">Expand all</button>
                            <button type="button" class="action-button small" @onclick="CollapseAll">Collapse all</button>
                        </div>

                        @* Every span as a thin line: the shape of the whole trace at a glance. *@
                        <div class="trace-minimap" aria-hidden="true">
                            @for ( int i = 0; i < Tree.Rows.Count; i++ )
                            {
                                TelemetryTraceRow row = Tree.Rows[i];
                                <span class="svc-@row.ServiceIndex @( row.Span.ID == _span?.ID ? "selected" : string.Empty )"
                                      style="left: @Percent( row.OffsetPercent ); width: @Percent( row.WidthPercent ); top: @Percent( 100.0 * i / Tree.Rows.Count ); height: @Percent( 100.0 / Tree.Rows.Count )"></span>
                            }
                        </div>

                        <div class="trace-header">
                            <div class="trace-header-label">Service &amp; Operation</div>
                            <div class="trace-ticks" aria-hidden="true">
                                @foreach ( ( double percent, double milliseconds ) in Tree.Ticks() )
                                {
                                    <span style="left: @Percent( percent )">@TelemetryDashboardFormatter.FormatDuration( milliseconds )</span>
                                }
                            </div>
                        </div>

                        <ol class="trace-waterfall">
                            @foreach ( TelemetryTraceRow row in Tree.Visible( _collapsed ) )
                            {
                                TelemetrySpanRecordDto span      = row.Span;
                                bool                   selected  = span.ID == _span?.ID;
                                bool                   error     = string.Equals( span.StatusCode, "Error", StringComparison.OrdinalIgnoreCase );
                                bool                   collapsed = _collapsed.Contains( span.ID );

                                <li @key="span.ID" class="trace-row @( selected ? "selected" : string.Empty )">
                                    <div class="trace-label" style="padding-left: @( row.Depth * 0.9 )rem">
                                        @if ( row.HasChildren )
                                        {
                                            <button type="button"
                                                    class="trace-toggle"
                                                    aria-expanded="@( collapsed ? "false" : "true" )"
                                                    aria-label="@( collapsed ? "Expand" : "Collapse" ) @span.Name"
                                                    @onclick="() => Toggle( span.ID )">@( collapsed ? "\u25B8" : "\u25BE" )</button>
                                        }
                                        else
                                        {
                                            <span class="trace-toggle" aria-hidden="true"></span>
                                        }
                                        <button type="button"
                                                class="trace-select"
                                                aria-pressed="@( selected ? "true" : "false" )"
                                                title="@( $"{span.ServiceName ?? "unknown"}: {span.Name} ({TelemetryDashboardFormatter.FormatDuration( span.DurationMilliseconds )})" )"
                                                @onclick="() => PickSpan( span )">
                                            <span class="svc-stripe svc-@row.ServiceIndex"></span>
                                            <span class="trace-service">@( span.ServiceName ?? "unknown" )</span>
                                            <span class="trace-name">@( span.Name ?? "span" )</span>
                                            @if ( error )
                                            {
                                                <span class="badge sev-error">error</span>
                                            }
                                        </button>
                                    </div>
                                    <div class="trace-track" @onclick="() => PickSpan( span )">
                                        <span class="trace-bar svc-@row.ServiceIndex @( error ? "is-error" : string.Empty )"
                                              style="left: @Percent( row.OffsetPercent ); width: @Percent( row.WidthPercent )"></span>
                                        @foreach ( double mark in LogMarks( span ) )
                                        {
                                            <span class="trace-log-mark" style="left: @Percent( mark )"></span>
                                        }
                                        <span class="trace-duration" style="@DurationPosition( row )">@TelemetryDashboardFormatter.FormatDuration( span.DurationMilliseconds )</span>
                                    </div>
                                </li>
                            }
                        </ol>
                    }

                    @if ( trace.Logs.Count > 0 )
                    {
                        <details class="attribute-group" open>
                            <summary>Logs in this trace <span class="muted">(@trace.Logs.Count)</span></summary>
                            <div class="table-wrap">
                                <table class="selectable">
                                    <tbody>
                                    @foreach ( TelemetryLogRecordDto log in trace.Logs )
                                    {
                                        <tr @key="log.ID"
                                            class="@TelemetryDashboardFormatter.RowClass( log.ID == _log?.ID )"
                                            tabindex="0"
                                            aria-selected="@( log.ID == _log?.ID ? "true" : "false" )"
                                            @onclick="() => PickLog( log )"
                                            @onkeydown="args => OnLogKeyDown( args, log )">
                                            <td>@TelemetryDashboardFormatter.FormatDate( log.TimestampUtc ?? log.ObservedTimestampUtc ?? log.ReceivedAtUtc )</td>
                                            <td><span class="badge @TelemetryDashboardFormatter.SeverityClass( log.SeverityNumber )">@( log.SeverityText ?? log.SeverityNumber.ToString() )</span></td>
                                            <td>@TelemetryDashboardFormatter.Trim( log.Body, 120 )</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </section>
            }

            @if ( _log is not null || _span is not null || _metric is not null )
            {
                <TelemetryRecordDetails Log="_log"
                                        Span="_span"
                                        Metric="_metric"
                                        ShowTrace="ShowTrace"
                                        OpenTrace="args => OpenTraceAsync( args.TraceId, args.SpanId )" />
            }
        </div>
    </div>
</div>

@code {
    [Inject] public required TelemetryQueryService Telemetry { get; init; }

    /// <summary> The record that was clicked; opening a span opens its whole trace. </summary>
    [Parameter] public TelemetryLogRecordDto? Log { get; set; }

    [Parameter] public TelemetrySpanRecordDto?   Span   { get; set; }
    [Parameter] public TelemetryMetricRecordDto? Metric { get; set; }

    /// <summary> What the dashboard already has loaded, shown at once while the whole trace loads (and kept if it can't be loaded). </summary>
    [Parameter] public IReadOnlyList<TelemetrySpanRecordDto> KnownSpans { get; set; } = [ ];

    [Parameter] public IReadOnlyList<TelemetryLogRecordDto>              KnownLogs { get; set; } = [ ];
    [Parameter] public EventCallback                                     Close     { get; set; }
    [Parameter] public EventCallback<(string TraceId, TelemetryTab Tab)> ShowTrace { get; set; }

    private ElementReference         _dialog;
    private CancellationTokenSource? _loading;
    private Guid?                    _opened;
    private bool                     _focused;
    private bool                     _loadingTrace;
    private string?                  _traceError;
    private string?                  _wantedSpanId;
    private TelemetryLogRecordDto?   _log;
    private TelemetrySpanRecordDto?  _span;
    private TelemetryMetricRecordDto? _metric;

    private readonly HashSet<Guid> _collapsed = [ ];

    private TelemetryTraceDto? Trace { get; set; }
    private TelemetryTraceTree Tree  { get; set; } = TelemetryTraceTree.Build( [ ] );


    public void Dispose()
    {
        _loading?.Cancel();
        _loading?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        Guid? opened = Log?.ID ?? Span?.ID ?? Metric?.ID;
        if ( opened == _opened ) { return; }

        _opened = opened;
        _log    = Log;
        _span   = Span;
        _metric = Metric;
        Trace   = null;

        if ( Span is { TraceId: { } traceId } span ) { await OpenTraceAsync( traceId, span.SpanId ); }
    }

    protected override async Task OnAfterRenderAsync( bool firstRender )
    {
        if ( _focused ) { return; }

        _focused = true;

        try { await _dialog.FocusAsync(); } // Escape closes it, so keyboard focus must start inside
        catch ( Exception e ) when ( e is JSException or JSDisconnectedException or InvalidOperationException ) { }
    }

    /// <summary> Shows the trace from what is loaded right away, then replaces it with every span and log of the trace from the database. </summary>
    private async Task OpenTraceAsync( string traceId, string? spanId )
    {
        _loading?.Cancel();
        _loading?.Dispose();
        _loading = new CancellationTokenSource();
        CancellationToken token = _loading.Token;

        // A linked trace replaces the current one; a log keeps its details while its own trace opens around it.
        if ( _span?.TraceId != traceId ) { _span = null; }

        if ( _log?.TraceId != traceId ) { _log = null; }

        _metric       = null;
        _wantedSpanId = spanId;
        SetTrace( new TelemetryTraceDto( traceId,
                                         KnownSpans.Where( x => x.TraceId == traceId ).ToArray(),
                                         KnownLogs.Where( x => x.TraceId == traceId ).OrderBy( static x => x.TimestampUtc ?? x.ObservedTimestampUtc ?? x.ReceivedAtUtc ).ToArray() ) );

        _loadingTrace = true;
        _traceError   = null;
        StateHasChanged();

        try
        {
            TelemetryTraceDto loaded = await Telemetry.GetTraceAsync( traceId, token );
            if ( token.IsCancellationRequested ) { return; }

            if ( loaded.Spans.Count > 0 || loaded.Logs.Count > 0 ) { SetTrace( loaded ); }
        }
        catch ( OperationCanceledException ) when ( token.IsCancellationRequested ) { return; }
        catch ( Exception e ) { _traceError = $"Showing only the spans already loaded: the whole trace couldn't be loaded ({e.Message.TrimEnd( '.' )})."; }

        _loadingTrace = false;
    }

    private void SetTrace( TelemetryTraceDto trace )
    {
        if ( Trace?.TraceId != trace.TraceId ) { _collapsed.Clear(); }

        Trace = trace;
        Tree  = TelemetryTraceTree.Build( trace.Spans );

        // The fresh copies of what is selected (the database has the trace's latest spans).
        if ( _span is { } span ) { _span = trace.Spans.FirstOrDefault( x => x.ID == span.ID ) ?? span; }

        if ( _log is { } log ) { _log = trace.Logs.FirstOrDefault( x => x.ID == log.ID ) ?? log; }

        // The span the trace was opened for, once it is there (it may only arrive with the database copy); with nothing selected, the trace's first span.
        if ( _wantedSpanId is not null && trace.Spans.FirstOrDefault( x => x.SpanId == _wantedSpanId ) is { } wanted )
        {
            SelectSpan( wanted );
            _wantedSpanId = null;
        }
        else if ( _span is null && _log is null && Tree.Rows.Count > 0 ) { SelectSpan( Tree.Rows[0].Span ); }
    }

    private void SelectSpan( TelemetrySpanRecordDto span )
    {
        _span   = span;
        _log    = null;
        _metric = null;
    }

    private void Toggle( Guid id )
    {
        if ( !_collapsed.Remove( id ) ) { _collapsed.Add( id ); }
    }

    private void ExpandAll() => _collapsed.Clear();

    /// <summary> Collapses the roots, so only the top level stays visible. </summary>
    private void CollapseAll()
    {
        foreach ( TelemetryTraceRow row in Tree.Rows.Where( static x => x.HasChildren && x.Depth == 0 ) ) { _collapsed.Add( row.Span.ID ); }
    }

    /// <summary> Where the span's logs fall on the trace's timeline (percent), like Jaeger's log ticks. </summary>
    private IEnumerable<double> LogMarks( TelemetrySpanRecordDto span )
    {
        if ( Trace is null || span.SpanId is null || Tree.StartUtc is not { } start || Tree.DurationMilliseconds <= 0 ) { yield break; }

        foreach ( TelemetryLogRecordDto log in Trace.Logs )
        {
            if ( log.SpanId != span.SpanId || ( log.TimestampUtc ?? log.ObservedTimestampUtc ) is not { } time ) { continue; }

            yield return Math.Clamp( ( time - start ).TotalMilliseconds / Tree.DurationMilliseconds * 100, 0, 100 );
        }
    }

    /// <summary> The duration label sits right of the bar; left of it when the bar ends near the track's end; inside it when the bar spans nearly everything. </summary>
    private static string DurationPosition( TelemetryTraceRow row )
    {
        double end = row.OffsetPercent + row.WidthPercent;

        return end <= 80                ? $"left: calc({Percent( end )} + 0.35rem)"
               : row.OffsetPercent >= 20 ? $"right: calc({Percent( 100 - row.OffsetPercent )} + 0.35rem)"
                                          : $"right: calc({Percent( 100 - end )} + 0.35rem); color: var(--bg)";
    }

    private static string ShortId( string traceId ) => traceId.Length > 7
                                                           ? traceId[..7]
                                                           : traceId;

    private void PickSpan( TelemetrySpanRecordDto span )
    {
        _wantedSpanId = null; // the user's choice wins over the span the trace was opened for
        SelectSpan( span );
    }

    private void PickLog( TelemetryLogRecordDto log )
    {
        _wantedSpanId = null;
        _log          = log;
        _span         = null;
        _metric       = null;
    }

    private void OnLogKeyDown( KeyboardEventArgs args, TelemetryLogRecordDto log )
    {
        if ( TelemetryDashboardFormatter.IsActivationKey( args ) ) { PickLog( log ); }
    }

    private Task OnKeyDown( KeyboardEventArgs args ) => args.Key == "Escape"
                                                            ? Close.InvokeAsync()
                                                            : Task.CompletedTask;

    private static string Percent( double value ) => value.ToString( "0.###", System.Globalization.CultureInfo.InvariantCulture ) + "%";
}
