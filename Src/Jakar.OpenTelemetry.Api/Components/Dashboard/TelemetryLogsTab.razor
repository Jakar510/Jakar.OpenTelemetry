<div class="panel-head">
    <div>
        <p class="eyebrow">Logs</p>
        <h3>@TelemetryDashboardFormatter.FormatCount( Records.Count ) records</h3>
    </div>
    <span>Select a record to see every field, attribute, and attached screenshot.</span>
</div>

@if ( Records.Count == 0 )
{
    <p class="empty-state">No logs match the current filter set.</p>
}
else
{
    <div class="table-wrap virtual-table">
        <table class="selectable">
            <thead>
            <tr>
                <th>Timestamp</th>
                <th>Service</th>
                <th>Severity</th>
                <th>Body</th>
                <th>Trace</th>
                <th>Scope</th>
                <th>Attributes</th>
            </tr>
            </thead>
            <tbody>
            @* Only the rows in view (plus a few) exist in the page; the rest are spacers. *@
            <Virtualize Items="Items" Context="log" ItemSize="46" OverscanCount="15" SpacerElement="tr">
                @{ int images = TelemetryDashboardFormatter.GetImageTags( log ).Count; }

                <tr @key="log.ID"
                    class="@TelemetryDashboardFormatter.RowClass( log.ID == SelectedId )"
                    tabindex="0"
                    aria-selected="@( log.ID == SelectedId ? "true" : "false" )"
                    @onclick="() => SelectedChanged.InvokeAsync( log.ID )"
                    @onkeydown="args => OnKeyDown( args, log.ID )">
                    <td>@TelemetryDashboardFormatter.FormatDate( log.TimestampUtc ?? log.ObservedTimestampUtc ?? log.ReceivedAtUtc )</td>
                    <td>@( log.ServiceName ?? "unknown" )</td>
                    <td><span class="badge @TelemetryDashboardFormatter.SeverityClass( log.SeverityNumber )">@( log.SeverityText ?? log.SeverityNumber.ToString() )</span></td>
                    <td title="@TelemetryDashboardFormatter.CleanJson( log.Body )">
                        @if ( images > 0 )
                        {
                            <span class="badge image-badge" title="@( $"{images} screenshot(s) attached" )">&#128247; @images</span>
                        }
                        @TelemetryDashboardFormatter.Trim( log.Body, 120 )
                    </td>
                    <td title="@( $"{log.TraceId} / {log.SpanId}" )">@TelemetryDashboardFormatter.Trim( log.TraceId, 16 )</td>
                    <td>@TelemetryDashboardFormatter.Trim( $"{log.ScopeName} {log.ScopeVersion}".Trim(), 28 )</td>
                    <td title="@TelemetryDashboardFormatter.AttributesText( log.Attributes )">@TelemetryDashboardFormatter.Trim( TelemetryDashboardFormatter.AttributesText( log.Attributes ), 72 )</td>
                </tr>
            </Virtualize>
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary> Virtualize needs a collection with a count; the explorer passes lists. </summary>
    private ICollection<TelemetryLogRecordDto> Items => Records as ICollection<TelemetryLogRecordDto> ?? Records.ToList();

    [Parameter] public IReadOnlyList<TelemetryLogRecordDto> Records         { get; set; } = [ ];
    [Parameter] public Guid?                                SelectedId      { get; set; }
    [Parameter] public EventCallback<Guid>                  SelectedChanged { get; set; }

    private Task OnKeyDown( KeyboardEventArgs args, Guid id ) => TelemetryDashboardFormatter.IsActivationKey( args )
                                                                    ? SelectedChanged.InvokeAsync( id )
                                                                    : Task.CompletedTask;
}
