<section class="hero-panel" title="The explorer refreshes as OTLP data is ingested (at most once per second) and pivots across logs, traces, metrics, and screenshots without leaving the page.">
    <div class="hero-head">
        <p class="eyebrow">Live Stream</p>
        <div class="status-pill @StateClass" role="status">@StateLabel</div>
    </div>

    <button type="button"
            class="action-button small"
            aria-pressed="@( LiveUpdates ? "true" : "false" )"
            @onclick="() => LiveUpdatesToggled.InvokeAsync()">
        @( LiveUpdates ? "Pause live updates" : "Resume live updates" )
    </button>

    <div class="status-detail" title="@LastEventLabel">@LastEventLabel</div>
</section>


@code {
    [Parameter] public required string        StateClass         { get; set; }
    [Parameter] public required string        StateLabel         { get; set; }
    [Parameter] public required string        LastEventLabel     { get; set; }
    [Parameter] public          bool          LiveUpdates        { get; set; }
    [Parameter] public          EventCallback LiveUpdatesToggled { get; set; }
}
