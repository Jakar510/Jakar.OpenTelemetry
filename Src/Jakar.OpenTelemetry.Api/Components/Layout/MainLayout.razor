@using Microsoft.Extensions.Options
@inherits LayoutComponentBase
@inject ILogger<MainLayout> Logger
@inject IOptions<PortalConfiguration> Portal

<div class="shell">
    <header class="shell-header">
        @* Wording and visibility come from the "Portal" configuration section. *@
        <div class="shell-brand">
            @if ( Portal.Value.ShowEyebrow && !string.IsNullOrWhiteSpace( Portal.Value.Eyebrow ) )
            {
                <p class="eyebrow">@Portal.Value.Eyebrow</p>
            }
            @if ( Portal.Value.ShowTitle && !string.IsNullOrWhiteSpace( Portal.Value.Title ) )
            {
                <h1>@Portal.Value.Title</h1>
            }
            @if ( Portal.Value.ShowSubtitle && !string.IsNullOrWhiteSpace( Portal.Value.Subtitle ) )
            {
                <p class="shell-copy" title="@Portal.Value.Subtitle">@Portal.Value.Subtitle</p>
            }
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="shell-actions">
                    <nav class="shell-nav" aria-label="Main">
                        <a class="tab" href="swagger" target="_blank" rel="noopener">API docs</a>
                    </nav>

                    <span class="shell-user">@context.User.Identity?.Name</span>

                    <form method="post"
                          action="/auth/logout">
                        <button type="submit"
                                class="action-button">
                            Sign out
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="shell-body">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <section class="error-banner" role="alert">
                    <strong>This view failed to render.</strong> @exception.Message.TrimEnd( '.' )
                    <button type="button" class="action-button small" @onclick="Recover">Try again</button>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    // Navigating away from a failed view must not keep showing the error.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover()
    {
        Logger.LogInformation( "Dashboard view recovered after render failure" );
        _errorBoundary?.Recover();
    }
}
