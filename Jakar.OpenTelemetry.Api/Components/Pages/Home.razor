@page "/"
@attribute [Authorize(Policy = AppAuthPolicies.DASHBOARD_ACCESS)]

<PageTitle>Telemetry Portal</PageTitle>

<div class="dashboard">
    <TelemetryHeroPanel StateClass="@ConnectionStateClass"
                        StateLabel="@ConnectionStateLabel"
                        LastEventLabel="@LastEventLabel"
                        LiveUpdates="@LiveUpdates"
                        LiveUpdatesToggled="ToggleLiveUpdatesAsync" />

    @if ( !string.IsNullOrWhiteSpace( ErrorMessage ) )
    {
        <section class="error-banner" role="alert">@ErrorMessage</section>
    }

    <section class="stat-grid">
        <StatCard Label="Total Logs"
                  Value="@FormatCount( Snapshot?.Overview.TotalLogs ?? 0 )"
                  Detail="@( $"{FormatCount( VisibleLogs.Count )} loaded" )" />
        <StatCard Label="Total Spans"
                  Value="@FormatCount( Snapshot?.Overview.TotalSpans ?? 0 )"
                  Detail="@( $"{FormatCount( VisibleSpans.Count )} loaded" )" />
        <StatCard Label="Total Metrics"
                  Value="@FormatCount( Snapshot?.Overview.TotalMetrics ?? 0 )"
                  Detail="@( $"{FormatCount( VisibleMetrics.Count )} loaded" )" />
        <StatCard Label="Snapshot Age"
                  Value="@SnapshotAgeLabel"
                  Detail="@GeneratedAtLabel" />
    </section>

    <section class="chart-grid">
        <PanelCard Eyebrow="Timeline"
                   Title="Logs"
                   Meta="10 minute buckets">
            <LineChart
                Points="@( Snapshot?.Overview.LogTimeline ?? [ ] )"
                Stroke="#ffb84d"
                EmptyMessage="No log samples yet." />
        </PanelCard>

        <PanelCard Eyebrow="Timeline"
                   Title="Spans"
                   Meta="10 minute buckets">
            <LineChart
                Points="@( Snapshot?.Overview.SpanTimeline ?? [ ] )"
                Stroke="#62d6ff"
                EmptyMessage="No spans yet." />
        </PanelCard>

        <PanelCard Eyebrow="Timeline"
                   Title="Metrics"
                   Meta="10 minute buckets">
            <LineChart Points="@( Snapshot?.Overview.MetricTimeline ?? [ ] )"
                       Stroke="#6cf0a8"
                       EmptyMessage="No metric points yet." />
        </PanelCard>

        <PanelCard Eyebrow="Breakdown"
                   Title="Severities"
                   Meta="Recent log window">
            <BarChart Items="@( Snapshot?.Overview.SeverityBreakdown ?? [ ] )"
                      BarColor="#ff7a59"
                      EmptyMessage="Severity buckets appear when logs arrive." />
        </PanelCard>

        <PanelCard Eyebrow="Breakdown"
                   Title="Services"
                   Meta="Across all signals">
            <BarChart Items="@( Snapshot?.Overview.ServiceBreakdown ?? [ ] )"
                      BarColor="#7f86ff"
                      EmptyMessage="Service names appear from resource attributes." />
        </PanelCard>

        <PanelCard Eyebrow="Breakdown"
                   Title="Metrics"
                   Meta="Named series">
            <BarChart Items="@( Snapshot?.Overview.MetricBreakdown ?? [ ] )"
                      BarColor="#49dcb1"
                      EmptyMessage="Metric names appear when points arrive." />
        </PanelCard>
    </section>

    <TelemetryExplorerPanel IsLoading="@IsLoading"
                            ActiveTab="@ActiveTab"
                            ActiveTabChanged="SetActiveTabAsync"
                            RefreshRequested="RefreshAsync"
                            SearchText="@SearchText"
                            SearchTextChanged="OnSearchTextChanged"
                            SelectedService="@SelectedService"
                            SelectedServiceChanged="OnSelectedServiceChanged"
                            SelectedCategoryToken="@SelectedCategoryToken"
                            SelectedCategoryTokenChanged="OnSelectedCategoryTokenChanged"
                            CategoryValue="@CategoryValue"
                            CategoryValueChanged="OnCategoryValueChanged"
                            SelectedSortToken="@SelectedSortToken"
                            SelectedSortTokenChanged="OnSelectedSortTokenChanged"
                            SortDescending="@SortDescending"
                            SortDescendingChanged="OnSortDescendingChanged"
                            SelectedSeverity="@SelectedSeverity"
                            SelectedSeverityChanged="OnSelectedSeverityChanged"
                            SelectedSpanKind="@SelectedSpanKind"
                            SelectedSpanKindChanged="OnSelectedSpanKindChanged"
                            SelectedMetricName="@SelectedMetricName"
                            SelectedMetricNameChanged="OnSelectedMetricNameChanged"
                            ServiceOptions="@ServiceOptions"
                            CategoryOptions="@CategoryOptions"
                            SortOptions="@SortOptions"
                            SeverityOptions="@SeverityOptions"
                            SpanKindOptions="@SpanKindOptions"
                            MetricNameOptions="@MetricNameOptions" />

    <section class="panel-card table-card">
        @if ( ActiveTab == TelemetryTab.Logs )
        {
            <TelemetryLogsTab Records="VisibleLogs" SelectedId="SelectedRecordId" SelectedChanged="SelectRecord" />
        }

        @if ( ActiveTab == TelemetryTab.Spans )
        {
            <TelemetrySpansTab Records="VisibleSpans" SelectedId="SelectedRecordId" SelectedChanged="SelectRecord" />
        }

        @if ( ActiveTab == TelemetryTab.Metrics )
        {
            <TelemetryMetricsTab Records="VisibleMetrics" SelectedId="SelectedRecordId" SelectedChanged="SelectRecord" />
        }
    </section>

    @if ( SelectedLog is not null || SelectedSpan is not null || SelectedMetric is not null )
    {
        <TelemetryRecordDetails Log="SelectedLog"
                                Span="SelectedSpan"
                                Metric="SelectedMetric"
                                Close="CloseDetails"
                                ShowTrace="args => ShowTrace( args.TraceId, args.Tab )" />
    }

    @if ( !IsLoading && Snapshot is null or { Overview: { TotalLogs: 0, TotalSpans: 0, TotalMetrics: 0 } } )
    {
        <PanelCard Eyebrow="No Data"
                   Title="Collector endpoints are ready">
            <p class="empty-state">Export OTLP over gRPC or HTTP (<code>/v1/traces</code>, <code>/v1/metrics</code>, <code>/v1/logs</code>)
                                   and the dashboard populates automatically.</p>
        </PanelCard>
    }
</div>
