<div class="panel-head">
    <div>
        <p class="eyebrow">Traces</p>
        <h3>@TelemetryDashboardFormatter.FormatCount( Records.Count ) spans</h3>
    </div>
    <span>Span durations, kinds, status, links, and scoped attributes.</span>
</div>

@if ( Records.Count == 0 )
{
    <p class="empty-state">No spans match the current filter set.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th>Start</th>
                <th>Service</th>
                <th>Name</th>
                <th>Kind</th>
                <th>Duration</th>
                <th>Status</th>
                <th>Trace</th>
                <th>Attributes</th>
            </tr>
            </thead>
            <tbody>
            @foreach ( TelemetrySpanRecordDto span in Records )
            {
                <tr>
                    <td>@TelemetryDashboardFormatter.FormatDate( span.StartTimeUtc ?? span.ReceivedAtUtc )</td>
                    <td>@( span.ServiceName ?? "unknown" )</td>
                    <td title="@span.Name">@TelemetryDashboardFormatter.Trim( span.Name, 48 )</td>
                    <td>@span.Kind</td>
                    <td>@( $"{span.DurationMilliseconds:0.###} ms" )</td>
                    <td title="@span.StatusMessage">@TelemetryDashboardFormatter.Trim( span.StatusCode, 24 )</td>
                    <td title="@( $"{span.TraceId} / {span.SpanId}" )">@TelemetryDashboardFormatter.Trim( span.TraceId, 16 )</td>
                    <td title="@TelemetryDashboardFormatter.FormatMap( span.Attributes )">@TelemetryDashboardFormatter.Trim( TelemetryDashboardFormatter.FormatMap( span.Attributes ), 72 )</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<TelemetrySpanRecordDto> Records { get; set; } = [ ];
}
