@inherits LayoutComponentBase
@inject ILogger<MainLayout> Logger

<div class="shell">
    <header class="shell-header">
        <div>
            <div>
                <p class="eyebrow">Jakar OpenTelemetry</p>
                <h1>Portal</h1>
            </div>
            <p class="shell-copy">Live telemetry for OTLP logs, traces, spans, metrics, and error screenshots.</p>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="shell-actions">
                    <nav class="shell-nav" aria-label="Main">
                        <NavLink class="tab" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                        <NavLink class="tab" href="screenshots">Screenshots</NavLink>
                        <a class="tab" href="swagger" target="_blank" rel="noopener">API docs</a>
                    </nav>

                    <span class="shell-user">@context.User.Identity?.Name</span>

                    <form method="post"
                          action="/auth/logout">
                        <button type="submit"
                                class="action-button">
                            Sign out
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="shell-body">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <section class="error-banner" role="alert">
                    <strong>This view failed to render.</strong> @exception.Message.TrimEnd( '.' )
                    <button type="button" class="action-button small" @onclick="Recover">Try again</button>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    // Navigating away from a failed view must not keep showing the error.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover()
    {
        Logger.LogInformation( "Dashboard view recovered after render failure" );
        _errorBoundary?.Recover();
    }
}
