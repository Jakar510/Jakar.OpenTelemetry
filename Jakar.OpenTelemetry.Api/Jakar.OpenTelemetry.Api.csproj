<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" Version="2.76.0"/>
        <PackageReference Include="Grpc.Tools" Version="2.80.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Jakar.Extensions" Version="10.8.3" />
        <PackageReference Include="Microsoft.OpenApi" Version="1.6.25" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" Version="10.0.7" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
        <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.Memory" Version="2.6.0" />
        <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0" />
        <PackageReference Include="ZiggyCreatures.FusionCache.OpenTelemetry" Version="2.6.0" />
        <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.NewtonsoftJson" Version="2.6.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jakar.OpenTelemetry.Contracts\Jakar.OpenTelemetry.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\opentelemetry\proto\common\v1\common.proto" GrpcServices="None" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\opentelemetry\proto\resource\v1\resource.proto" GrpcServices="None" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\opentelemetry\proto\logs\v1\logs.proto" GrpcServices="None" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\opentelemetry\proto\metrics\v1\metrics.proto" GrpcServices="None" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\opentelemetry\proto\trace\v1\trace.proto" GrpcServices="None" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\opentelemetry\proto\collector\logs\v1\logs_service.proto" GrpcServices="Server" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\opentelemetry\proto\collector\metrics\v1\metrics_service.proto" GrpcServices="Server" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\opentelemetry\proto\collector\trace\v1\trace_service.proto" GrpcServices="Server" ProtoRoot="Protos"/>
    </ItemGroup>

</Project>
