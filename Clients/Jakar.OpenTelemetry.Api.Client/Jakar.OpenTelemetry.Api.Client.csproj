<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>10.1.0</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Description>Durable OpenTelemetry client for Jakar.OpenTelemetry.Api: OTLP logs/traces/metrics, crash reports, and screenshot uploads referenced from logs via log.tags.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Jakar.OpenTelemetry.Contracts\Jakar.OpenTelemetry.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <InternalsVisibleTo Include="Jakar.OpenTelemetry.Api.Client.Tests" />
        <InternalsVisibleTo Include="Jakar.OpenTelemetry.Api.Client.Blazor.WebAssembly.Tests" />
        <InternalsVisibleTo Include="Jakar.OpenTelemetry.Api.Client.Maui.Tests" />
        <InternalsVisibleTo Include="Jakar.OpenTelemetry.Api.IntegrationTests" />
        <InternalsVisibleTo Include="Jakar.OpenTelemetry.Testing" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

</Project>
